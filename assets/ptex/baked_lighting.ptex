","type":"linked_control"},{"label":"| Precision","linked_widgets":[{"node":"18118_3","widget":"sha_prec"}],"name":"param5","shortdesc":"Shadow Precision","type":"linked_control"},{"label":"| Softness","linked_widgets":[{"node":"18118_3","widget":"sha_soft"}],"name":"param4","shortdesc":"Shadow Softness","type":"linked_control"},{"label":"| Quality","linked_widgets":[{"node":"18118_3","widget":"sha_soft_q"}],"longdesc":"The number of iterations performed for the soft shadows. Note this amount of iterations are performed for each Shadow Precission step, so be careful with having both Shadow Precission and Softness Quality high.","name":"param7","shortdesc":"Softness Quality","type":"linked_control"},{"configurations":{"False":[{"node":"switch","value":0.0,"widget":"source"}],"True":[{"node":"switch","value":1.0,"widget":"source"}]},"label":"| Denoise","linked_widgets":[{"node":"switch","widget":"source"}],"longdesc":"When this is enabled the shadow mask is run through a denoise node.","name":"param1","shortdesc":"Denoise Shadows","type":"config_control"},{"default":0.5,"label":"AO","max":10.0,"min":0.0,"name":"ao_i","step":0.1,"type":"named_parameter"},{"label":"| Radius","linked_widgets":[{"node":"voronoi_5","widget":"radius"}],"name":"param16","shortdesc":"AO Radius","type":"linked_control"},{"label":"| AngleBias","linked_widgets":[{"node":"voronoi_5","widget":"angleBiasDeg"}],"name":"param17","shortdesc":"AO Angle Bias","type":"linked_control"},{"label":"| Depth","linked_widgets":[{"node":"voronoi_5","widget":"depth_scale"}],"name":"param18","shortdesc":"AO Depth Scale","type":"linked_control"},{"label":"| Quality","linked_widgets":[{"node":"voronoi_5","widget":"quality"}],"name":"param19","shortdesc":"AO Quality","type":"linked_control"},{"label":"| Denoise","linked_widgets":[{"node":"tones_step","widget":"switch"}],"name":"param20","shortdesc":"AO Denoise","type":"linked_control"},{"label":"AO Mix","linked_widgets":[{"node":"blend2_6","widget":"amount1"}],"name"